EDGAR_USER_AGENT_NAME= Eden
EDGAR_USER_AGENT_EMAIL= supereden.se@gmail.com

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=financial-report-analyzer

# Gemini via API key (langchain-google-genai: classify/generate; google-genai: contextual retrieval)
GOOGLE_API_KEY=

# Postgres (query_logs, eval_set, filings, chunks) — docker-compose expune
# containerul pe portul 5433 (evita conflictul cu un Postgres de sistem pe 5432);
# docker-compose.yml suprascrie asta pentru serviciul api cu hostname-ul intern "postgres"
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/financial_report_analyzer

# Qdrant — implicit localhost; docker-compose.yml suprascrie cu "qdrant" pt serviciul api
QDRANT_URL=http://localhost:6333

# GCP — un singur service account/proiect pentru embeddings (Vertex AI) si reranker
# (Discovery Engine Ranking API). GOOGLE_APPLICATION_CREDENTIALS = calea catre
# JSON-ul service account-ului, sau gol daca folosesti `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
